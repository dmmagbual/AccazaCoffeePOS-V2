rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameOrg(orgId) { return signedIn() && request.auth.token.organizationId == orgId; }
    function sameStore(storeId) { return request.auth.token.storeIds.hasAny([storeId]); }
    function can(permission) { return signedIn() && request.auth.token.permissions.hasAny([permission]); }
    function validScope(data) { return sameOrg(data.organizationId) && sameStore(data.storeId); }
    function nonFinancialCollection(collection) { return collection != 'payments' && collection != 'receipts' && collection != 'cashDrawers' && collection != 'expenses' && collection != 'orders' && collection != 'suppliers' && collection != 'purchaseOrders' && collection != 'goodsReceipts' && collection != 'inventoryBatches' && collection != 'purchaseDocuments' && collection != 'featureDefinitions' && collection != 'featureConfigurations' && collection != 'storageLocations' && collection != 'inventoryLocationMovements' && collection != 'inventoryTransfers' && collection != 'inventoryReservations' && collection != 'productionRecipes' && collection != 'productionRecipeVersions' && collection != 'productionOrders' && collection != 'productionOutputs' && collection != 'productionBatches' && collection != 'productionWaste' && collection != 'productionCosts'; }
    match /{collection}/{id} {
      allow read: if validScope(resource.data);
      allow create: if nonFinancialCollection(collection) && validScope(request.resource.data) && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if nonFinancialCollection(collection) && validScope(resource.data) && validScope(request.resource.data) && resource.data.createdAt == request.resource.data.createdAt && resource.data.createdBy == request.resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if can('admin.delete');
    }
    // Ingredients are organization-controlled master data, not store-owned inventory.
    match /ingredients/{id} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if sameOrg(request.resource.data.organizationId) && can('ingredients.manage') && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if sameOrg(resource.data.organizationId) && sameOrg(request.resource.data.organizationId) && can('ingredients.manage') && resource.data.organizationId == request.resource.data.organizationId && resource.data.createdAt == request.resource.data.createdAt && resource.data.createdBy == request.resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    // Recipes and their versions are Head Office-controlled organization master data.
    match /recipes/{id} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if sameOrg(request.resource.data.organizationId) && can('recipes.manage') && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if sameOrg(resource.data.organizationId) && sameOrg(request.resource.data.organizationId) && can('recipes.manage') && resource.data.organizationId == request.resource.data.organizationId && resource.data.createdAt == request.resource.data.createdAt && resource.data.createdBy == request.resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /recipes/{recipeId}/versions/{versionId} {
      function recipeOrg() { return get(/databases/$(database)/documents/recipes/$(recipeId)).data.organizationId; }
      allow read: if sameOrg(recipeOrg());
      allow create: if sameOrg(recipeOrg()) && can('recipes.manage') && request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid;
      allow update: if sameOrg(recipeOrg()) && can('recipes.manage') && resource.data.status == 'draft' && (request.resource.data.status == 'draft' || can('recipes.publish')) && resource.data.createdAt == request.resource.data.createdAt && resource.data.createdBy == request.resource.data.createdBy;
      allow delete: if false;
    }
    match /{collection=payments|receipts|cashDrawers|expenses}/{id} { allow write: if can('finance.write'); }
    match /orders/{id} { allow write: if can('sales.write'); }
    match /suppliers/{id} { allow read: if validScope(resource.data); allow write: if can('procurement.manage'); }
    match /purchaseOrders/{id} { allow read: if validScope(resource.data); allow write: if can('procurement.manage'); }
    match /goodsReceipts/{id} { allow read: if validScope(resource.data); allow write: if can('procurement.receive'); }
    match /inventoryBatches/{id} { allow read: if validScope(resource.data); allow write: if can('procurement.receive'); }
    match /purchaseDocuments/{id} { allow read: if validScope(resource.data); allow write: if can('procurement.manage'); }
    match /featureDefinitions/{id} { allow read: if signedIn(); allow write: if can('platform.configure'); }
    match /featureConfigurations/{id} { allow read: if sameOrg(resource.data.organizationId); allow create, update: if sameOrg(request.resource.data.organizationId) && can('platform.configure') && request.resource.data.configuredBy == request.auth.uid; allow delete: if false; }
    match /storageLocations/{id} { allow read: if validScope(resource.data); allow create, update: if validScope(request.resource.data) && (can('platform.configure') || can('locations.manage')) && request.resource.data.updatedBy == request.auth.uid; allow delete: if false; }
    match /inventoryTransfers/{id} { allow read: if validScope(resource.data); allow create: if validScope(request.resource.data) && can('inventory.transfer') && request.resource.data.requestedBy == request.auth.uid; allow update: if validScope(resource.data) && validScope(request.resource.data) && can('inventory.transfer') && resource.data.branchId == request.resource.data.branchId && resource.data.status == 'DRAFT'; allow delete: if false; }
    match /{collection=inventoryLocationMovements|inventoryReservations}/{id} { allow read: if validScope(resource.data); allow create: if validScope(request.resource.data) && can('inventory.transfer'); allow update, delete: if false; }
    // Production recipes are centrally approved; operational records remain store scoped.
    match /productionRecipes/{id} { allow read: if sameOrg(resource.data.organizationId); allow create: if sameOrg(request.resource.data.organizationId) && can('production.manage') && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid; allow update: if sameOrg(resource.data.organizationId) && sameOrg(request.resource.data.organizationId) && can('production.manage') && resource.data.createdAt == request.resource.data.createdAt && resource.data.createdBy == request.resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid; allow delete: if false; }
    match /productionRecipeVersions/{id} { allow read: if sameOrg(resource.data.organizationId); allow create: if sameOrg(request.resource.data.organizationId) && can('production.manage') && request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid; allow update: if sameOrg(resource.data.organizationId) && can('production.manage') && resource.data.status == 'draft' && (request.resource.data.status == 'draft' || can('production.approve')); allow delete: if false; }
    match /productionOrders/{id} { allow read: if validScope(resource.data); allow create: if validScope(request.resource.data) && can('production.create') && request.resource.data.createdBy == request.auth.uid; allow update: if validScope(resource.data) && validScope(request.resource.data) && (can('production.manage') || (can('production.execute') && resource.data.producedBy == request.auth.uid)) && resource.data.createdAt == request.resource.data.createdAt && resource.data.createdBy == request.resource.data.createdBy; allow delete: if false; }
    match /{collection=productionOutputs|productionBatches|productionWaste|productionCosts}/{id} { allow read: if validScope(resource.data); allow create: if validScope(request.resource.data) && can('production.complete') && request.resource.data.createdBy == request.auth.uid; allow update, delete: if false; }
    match /{collection=users|roles|permissions}/{id} { allow write: if can('identity.manage'); }
  }
}
