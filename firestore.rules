rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function has(listName, value) { return signedIn() && request.auth.token[listName] != null && request.auth.token[listName].hasAny([value]); }
    function sameOrg(orgId) { return signedIn() && request.auth.token.organizationId == orgId; }
    function sameStore(storeId) { return has('storeIds', storeId); }
    function sameBranch(branchId) { return has('branchIds', branchId); }
    function can(permission) { return has('permissions', permission); }
    function storeScope(data) { return sameOrg(data.organizationId) && sameStore(data.storeId); }
    function branchScope(data) { return sameOrg(data.organizationId) && sameBranch(data.branchId); }
    function orgScope(data) { return sameOrg(data.organizationId); }
    function actorCreates(data) { return data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid; }
    function immutableAudit(before, after) { return before.createdAt == after.createdAt && before.createdBy == after.createdBy && before.organizationId == after.organizationId; }

    // Default deny: each collection must opt in below. This intentionally replaces
    // the former broad catch-all rule, which could grant a new collection access.
    match /{document=**} { allow read, write: if false; }

    // Centrally governed master data.
    match /{collection=ingredients|recipes|productionRecipes|productionRecipeVersions|unitsOfMeasure|productCategories|ingredientCategories|taxRates|paymentMethods|appSettings}/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /recipes/{recipeId}/versions/{versionId} {
      function recipeOrg() { return get(/databases/$(database)/documents/recipes/$(recipeId)).data.organizationId; }
      allow read: if sameOrg(recipeOrg());
      allow create: if sameOrg(recipeOrg()) && can('recipes.manage') && request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid;
      allow update: if sameOrg(recipeOrg()) && resource.data.status == 'draft' && can('recipes.manage') && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // Store/branch master records are readable in scope and role-managed.
    match /{collection=products|categories|modifiers|inventoryItems|suppliers|purchaseOrders|goodsReceipts|inventoryBatches|purchaseDocuments|storageLocations}/{id} {
      allow read: if storeScope(resource.data);
      allow create: if storeScope(request.resource.data) && can('procurement.manage') && actorCreates(request.resource.data);
      allow update: if storeScope(resource.data) && storeScope(request.resource.data) && can('procurement.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /{collection=customers|loyaltyAccounts}/{id} {
      allow read: if storeScope(resource.data) && can('customers.read');
      allow create, update: if storeScope(request.resource.data) && can('customers.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Financial, inventory, audit, and workflow evidence is service-account only.
    // Admin SDK and trusted server commands bypass these rules; browser clients
    // cannot forge ledgers, stock movements, approvals, or history.
    match /{collection=orders|orderItems|payments|receipts|shifts|cashDrawers|expenses|stockMovements|inventoryLocationMovements|inventoryReservations|supplierInvoices|accountsPayable|supplierPayments|supplierPaymentAllocations|journalEntries|journalLines|financeExpenses|cashTransfers|productionOrders|productionOutputs|productionBatches|productionWaste|productionCosts|auditLogs|workflowInstances|workflowHistory|approvalRequests|maintenanceWorkOrders}/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /inventoryTransfers/{id} {
      allow read: if sameOrg(resource.data.organizationId) && (sameBranch(resource.data.sourceBranchId) || sameBranch(resource.data.destinationBranchId)) && can('inventory.transfer');
      allow write: if false;
    }

    // Identity and confidential personnel data require dedicated permissions.
    match /{collection=users|roles|permissions}/{id} {
      allow read, write: if can('identity.manage');
    }
    match /{collection=people|employees|employeeBranchAssignments|attendanceEvents|employeeSkills|trainingRecords}/{id} {
      allow read: if orgScope(resource.data) && can('hr.confidential.read');
      allow create, update: if orgScope(request.resource.data) && can('hr.confidential.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /{collection=franchiseOrganizations|franchiseAgreements|royaltyRules|royaltyCalculations}/{id} {
      allow read: if orgScope(resource.data) && can('franchise.read');
      allow create, update: if orgScope(request.resource.data) && can('franchise.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
