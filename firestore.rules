rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function has(listName, value) { return signedIn() && request.auth.token[listName] != null && request.auth.token[listName].hasAny([value]); }
    function sameOrg(orgId) { return signedIn() && request.auth.token.organizationId == orgId; }
    function sameStore(storeId) { return has('storeIds', storeId); }
    function sameBranch(branchId) { return has('branchIds', branchId); }
    function can(permission) { return has('permissions', permission); }
    function storeScope(data) { return sameOrg(data.organizationId) && sameStore(data.storeId); }
    function branchScope(data) { return sameOrg(data.organizationId) && sameBranch(data.branchId); }
    function orgScope(data) { return sameOrg(data.organizationId); }
    function actorCreates(data) { return data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid; }
    function immutableAudit(before, after) { return before.createdAt == after.createdAt && before.createdBy == after.createdBy && before.organizationId == after.organizationId; }

    // Default deny: each collection must opt in below. This intentionally replaces
    // the former broad catch-all rule, which could grant a new collection access.
    match /{document=**} { allow read, write: if false; }

    // Centrally governed master data.
    match /recipes/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /productionRecipes/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /productionRecipeVersions/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /unitsOfMeasure/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /ingredientCategories/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /taxRates/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /paymentMethods/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /appSettings/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('master_data.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('master_data.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /ingredients/{id} {
      allow read: if orgScope(resource.data);
      allow create: if orgScope(request.resource.data) && can('ingredients.manage') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && can('ingredients.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /taxProfiles/{id} {
      allow read: if orgScope(resource.data) && can('tax.view');
      allow create: if orgScope(request.resource.data) && can('tax.manageProfiles') && actorCreates(request.resource.data);
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('tax.manageProfiles') || can('tax.changeRates'));
      allow delete: if false;
    }
    match /recipes/{recipeId}/versions/{versionId} {
      function recipeOrg() { return get(/databases/$(database)/documents/recipes/$(recipeId)).data.organizationId; }
      allow read: if sameOrg(recipeOrg());
      allow create: if sameOrg(recipeOrg()) && can('recipes.manage') && request.resource.data.status == 'draft' && request.resource.data.createdBy == request.auth.uid;
      allow update: if sameOrg(recipeOrg()) && resource.data.status == 'draft' && can('recipes.manage') && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // Store/branch master records are readable in scope and role-managed.
    match /inventoryItems/{id} {
      allow read: if storeScope(resource.data);
      allow create: if storeScope(request.resource.data) && can('procurement.manage') && actorCreates(request.resource.data);
      allow update: if storeScope(resource.data) && storeScope(request.resource.data) && can('procurement.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /suppliers/{id} {
      allow read: if storeScope(resource.data);
      allow create: if storeScope(request.resource.data) && can('procurement.manage') && actorCreates(request.resource.data);
      allow update: if storeScope(resource.data) && storeScope(request.resource.data) && can('procurement.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /purchaseOrders/{id} {
      allow read: if storeScope(resource.data);
      allow create: if storeScope(request.resource.data) && can('procurement.manage') && actorCreates(request.resource.data);
      allow update: if storeScope(resource.data) && storeScope(request.resource.data) && can('procurement.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /goodsReceipts/{id} {
      allow read: if storeScope(resource.data);
      allow create: if storeScope(request.resource.data) && can('procurement.manage') && actorCreates(request.resource.data);
      allow update: if storeScope(resource.data) && storeScope(request.resource.data) && can('procurement.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /inventoryBatches/{id} {
      allow read: if storeScope(resource.data);
      allow create: if storeScope(request.resource.data) && can('procurement.manage') && actorCreates(request.resource.data);
      allow update: if storeScope(resource.data) && storeScope(request.resource.data) && can('procurement.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /purchaseDocuments/{id} {
      allow read: if storeScope(resource.data);
      allow create: if storeScope(request.resource.data) && can('procurement.manage') && actorCreates(request.resource.data);
      allow update: if storeScope(resource.data) && storeScope(request.resource.data) && can('procurement.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /storageLocations/{id} {
      allow read: if storeScope(resource.data);
      allow create: if storeScope(request.resource.data) && can('procurement.manage') && actorCreates(request.resource.data);
      allow update: if storeScope(resource.data) && storeScope(request.resource.data) && can('procurement.manage') && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /products/{id} {
      allow read: if orgScope(resource.data) && can('catalog.view');
      allow create: if orgScope(request.resource.data) && actorCreates(request.resource.data) && (can('catalog.createProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('catalog.editProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow delete: if false;
    }
    match /productCategories/{id} {
      allow read: if orgScope(resource.data) && can('catalog.view');
      allow create: if orgScope(request.resource.data) && actorCreates(request.resource.data) && (can('catalog.createProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('catalog.editProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow delete: if false;
    }
    match /productVariations/{id} {
      allow read: if orgScope(resource.data) && can('catalog.view');
      allow create: if orgScope(request.resource.data) && actorCreates(request.resource.data) && (can('catalog.createProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('catalog.editProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow delete: if false;
    }
    match /optionGroups/{id} {
      allow read: if orgScope(resource.data) && can('catalog.view');
      allow create: if orgScope(request.resource.data) && actorCreates(request.resource.data) && (can('catalog.createProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('catalog.editProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow delete: if false;
    }
    match /optionItems/{id} {
      allow read: if orgScope(resource.data) && can('catalog.view');
      allow create: if orgScope(request.resource.data) && actorCreates(request.resource.data) && (can('catalog.createProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('catalog.editProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow delete: if false;
    }
    match /productOptionAssignments/{id} {
      allow read: if orgScope(resource.data) && can('catalog.view');
      allow create: if orgScope(request.resource.data) && actorCreates(request.resource.data) && (can('catalog.createProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('catalog.editProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow delete: if false;
    }
    match /productAvailability/{id} {
      allow read: if orgScope(resource.data) && can('catalog.view');
      allow create: if orgScope(request.resource.data) && actorCreates(request.resource.data) && (can('catalog.createProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('catalog.editProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow delete: if false;
    }
    match /posMenuLayouts/{id} {
      allow read: if orgScope(resource.data) && can('catalog.view');
      allow create: if orgScope(request.resource.data) && actorCreates(request.resource.data) && (can('catalog.createProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow update: if orgScope(resource.data) && orgScope(request.resource.data) && immutableAudit(resource.data, request.resource.data) && request.resource.data.updatedBy == request.auth.uid && (can('catalog.editProduct') || can('catalog.manageCategories') || can('catalog.manageVariations') || can('catalog.manageOptionGroups') || can('catalog.manageOptionItems') || can('catalog.manageAvailability') || can('catalog.managePOSLayout'));
      allow delete: if false;
    }
    match /customers/{id} {
      allow read: if storeScope(resource.data) && can('customers.read');
      allow create, update: if storeScope(request.resource.data) && can('customers.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /loyaltyAccounts/{id} {
      allow read: if storeScope(resource.data) && can('customers.read');
      allow create, update: if storeScope(request.resource.data) && can('customers.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    // Financial, inventory, audit, and workflow evidence is service-account only.
    // Admin SDK and trusted server commands bypass these rules; browser clients
    // cannot forge ledgers, stock movements, approvals, or history.
    match /orders/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /orderItems/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /payments/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /receipts/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data) || (orgScope(resource.data) && can('branches.all'))) && can('operations.read');
      allow write: if false;
    }
    match /cashierSaleSummaries/{id} {
      allow read: if sameOrg(resource.data.organizationId) && (can('branches.all') || sameBranch(resource.data.branchId)) && can('operations.read');
      allow write: if false;
    }
    match /shifts/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /cashDrawers/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /expenses/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /stockMovements/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /inventoryLocationMovements/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /inventoryReservations/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /supplierInvoices/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /accountsPayable/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /supplierPayments/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /supplierPaymentAllocations/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /journalEntries/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('finance.read');
      allow write: if false;
    }
    match /journalLines/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    // Trusted Finance, Loyalty, and shift evidence: written only by Admin SDK.
    match /financePostingRequests/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('finance.read');
      allow write: if false;
    }
    match /loyaltyTransactions/{id} {
      allow read: if orgScope(resource.data) && can('crm.loyalty.read');
      allow write: if false;
    }
    match /loyaltyBalances/{id} {
      allow read: if orgScope(resource.data) && can('crm.loyalty.read');
      allow write: if false;
    }
    match /loyaltyPostingRequests/{id} {
      allow read: if orgScope(resource.data) && can('crm.loyalty.manage');
      allow write: if false;
    }
    match /shiftTotals/{id} {
      allow read: if branchScope(resource.data) && can('operations.read');
      allow write: if false;
    }
    match /appliedShiftSales/{id} {
      allow read: if branchScope(resource.data) && can('operations.read');
      allow write: if false;
    }
    match /outboxEvents/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /financeExpenses/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /cashTransfers/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /productionOrders/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /productionOutputs/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /productionBatches/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /productionWaste/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /productionCosts/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /workflowInstances/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /workflowHistory/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /approvalRequests/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /maintenanceWorkOrders/{id} {
      allow read: if (storeScope(resource.data) || branchScope(resource.data)) && can('operations.read');
      allow write: if false;
    }
    match /inventoryTransfers/{id} {
      allow read: if sameOrg(resource.data.organizationId) && (sameBranch(resource.data.sourceBranchId) || sameBranch(resource.data.destinationBranchId)) && can('inventory.transfer');
      allow write: if false;
    }

    // Identity and confidential personnel data require dedicated permissions.
    match /users/{id} {
      allow read, write: if can('identity.manage');
    }
    match /roles/{id} {
      allow read, write: if can('identity.manage');
    }
    match /permissions/{id} {
      allow read, write: if can('identity.manage');
    }
    match /people/{id} {
      allow read: if orgScope(resource.data) && can('hr.confidential.read');
      allow create, update: if orgScope(request.resource.data) && can('hr.confidential.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /employees/{id} {
      allow read: if orgScope(resource.data) && can('hr.confidential.read');
      allow create, update: if orgScope(request.resource.data) && can('hr.confidential.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /employeeBranchAssignments/{id} {
      allow read: if orgScope(resource.data) && can('hr.confidential.read');
      allow create, update: if orgScope(request.resource.data) && can('hr.confidential.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /attendanceEvents/{id} {
      allow read: if orgScope(resource.data) && can('hr.confidential.read');
      allow create, update: if orgScope(request.resource.data) && can('hr.confidential.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /employeeSkills/{id} {
      allow read: if orgScope(resource.data) && can('hr.confidential.read');
      allow create, update: if orgScope(request.resource.data) && can('hr.confidential.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /trainingRecords/{id} {
      allow read: if orgScope(resource.data) && can('hr.confidential.read');
      allow create, update: if orgScope(request.resource.data) && can('hr.confidential.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /franchiseOrganizations/{id} {
      allow read: if orgScope(resource.data) && can('franchise.read');
      allow create, update: if orgScope(request.resource.data) && can('franchise.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /franchiseAgreements/{id} {
      allow read: if orgScope(resource.data) && can('franchise.read');
      allow create, update: if orgScope(request.resource.data) && can('franchise.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /royaltyRules/{id} {
      allow read: if orgScope(resource.data) && can('franchise.read');
      allow create, update: if orgScope(request.resource.data) && can('franchise.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /royaltyCalculations/{id} {
      allow read: if orgScope(resource.data) && can('franchise.read');
      allow create, update: if orgScope(request.resource.data) && can('franchise.manage') && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
