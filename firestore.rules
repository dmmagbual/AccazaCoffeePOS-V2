rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameOrg(orgId) { return signedIn() && request.auth.token.organizationId == orgId; }
    function sameStore(storeId) { return request.auth.token.storeIds.hasAny([storeId]); }
    function can(permission) { return signedIn() && request.auth.token.permissions.hasAny([permission]); }
    function validScope(data) { return sameOrg(data.organizationId) && sameStore(data.storeId); }
    match /{collection}/{id} {
      allow read: if validScope(resource.data);
      allow create: if validScope(request.resource.data) && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if validScope(resource.data) && validScope(request.resource.data) && resource.data.createdAt == request.resource.data.createdAt && resource.data.createdBy == request.resource.data.createdBy && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if can('admin.delete');
    }
    match /{collection=payments|receipts|cashDrawers|expenses}/{id} { allow write: if can('finance.write'); }
    match /{collection=users|roles|permissions}/{id} { allow write: if can('identity.manage'); }
  }
}
